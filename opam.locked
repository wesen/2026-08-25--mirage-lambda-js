# opam: 2.5.2
# This file records the pinned toolchain baseline for Phase 0.
# It is a hand-maintained pin record until a full `opam lock` is generated
# after the Phase 0 exit gate (see docs/adr/0000-toolchain-baseline.md).
#
# MirageOS / Solo5 / ocaml-solo5 / TLS / HTTP / KV / crypto packages are NOT
# installed in this switch; they require a dedicated Mirage opam switch and
# are added to the lockfile when Phase 5/6 work begins.

opam-version: "2.0"
available: true

# ---- compiler / build ----
ocaml:        "4.14.2"           # switch CP.2025.08.0~8.20~2025.01 (ocaml-variants.4.14.2+options + flambda)
dune:         "3.15+"            # build system (exact version pinned at lock time)

# ---- JSON / serialization (Phase 1) ----
yojson:       "2.2.2"            # manifest + bundle header JSON
ppx_yojson_conv: "v0.16.0"      # optional deriving of yojson converters

# ---- test / fuzz (Phase 1) ----
qcheck:       "0.23+"            # property tests (install before Phase 1)
alcotest:     "1.8+"             # unit test runner (install before Phase 1)
crowbar:      "0.4+"             # fuzz harness (install before Phase 1 fuzz)

# ---- JavaScript engine (Phase 0/2) ----
quickjs:      "2026-06-04"        # vendored release under qjs/vendor/ (digest recorded at vendor time)
# Note: QuickJS is vendored as C source, not an opam package.

# ---- Mirage / Solo5 (Phase 5/6) — to be pinned ----
# mirage:       "4.5+"
# ocaml-solo5:  "0.8+"
# solo5:        "0.8+"
# mirage-clock: "(lang any)"
# mirage-kv:    "7.0+"
# mirage-crypto: "1.1+"
# tls:          "0.17+"
# cohttp:       "5.3+"
# mtime:        "2.0+"

# ---- launcher integration (Phase 7) ----
# albatross:    "<pinned at Phase 7>"
